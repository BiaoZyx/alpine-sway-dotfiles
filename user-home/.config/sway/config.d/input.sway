# 输入设备（input）
# ------------------------------------------------------------
# 键盘默认打开 NumLock；触摸板使用自然滚动。
# 下面被注释掉的选项是备选/当前平台不支持，保留作备忘（文学编程：留下“为什么不用”）。
# ------------------------------------------------------------

# 默认启用 NumLock
input type:keyboard xkb_numlock enabled

# 触摸板
input type:touchpad {
    #events disabled                     # 默认禁用
    natural_scroll enabled              # 自然滚动
    #disabled_on_external_mouse enabled  # 连接鼠标自动禁用（当前平台暂不支持）
}


